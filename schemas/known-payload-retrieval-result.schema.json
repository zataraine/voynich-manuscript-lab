{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manuscript-lab.local/schemas/known-payload-retrieval-result.schema.json",
  "title": "Known-payload retrieval result",
  "type": "object",
  "required": [
    "schema_version", "experiment_id", "hypothesis_id", "run_finished_at",
    "source_audit", "normalization", "feature_panel", "cipher_suite",
    "family_results", "aggregate", "permutation", "interpretation_gate", "provenance"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "experiment_id": {"const": "E-005-known-payload-retrieval"},
    "hypothesis_id": {"const": "H-005"},
    "run_finished_at": {"type": "string", "format": "date-time"},
    "source_audit": {"type": "array", "minItems": 12, "maxItems": 12},
    "normalization": {"type": "object"},
    "feature_panel": {"type": "object"},
    "cipher_suite": {"type": "object"},
    "family_results": {"type": "object", "minProperties": 9, "maxProperties": 9},
    "aggregate": {"type": "object"},
    "permutation": {"type": "object"},
    "interpretation_gate": {
      "type": "object",
      "required": ["checks", "passed", "permitted_next_step", "voynich_scored", "posterior_probability"],
      "properties": {
        "checks": {"type": "object", "minProperties": 6, "maxProperties": 6},
        "passed": {"type": "boolean"},
        "permitted_next_step": {"type": "string"},
        "voynich_scored": {"const": false},
        "posterior_probability": {"type": "null"}
      }
    },
    "provenance": {"type": "object"}
  },
  "additionalProperties": false
}
