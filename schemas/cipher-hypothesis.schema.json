{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/manuscript-lab/cipher-hypothesis.schema.json",
  "title": "Cipher hypothesis specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "hypothesis_id", "status", "unitization", "stages", "evaluation"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "hypothesis_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "status": { "enum": ["proposed", "active", "rejected", "inconclusive"] },
    "unitization": { "enum": ["byte", "codepoint", "grapheme", "token", "region"] },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["family", "direction", "parameters"],
        "properties": {
          "family": {
            "enum": ["substitution", "homophonic", "nomenclator", "polyalphabetic", "progressive-key", "transposition", "null"]
          },
          "direction": { "enum": ["encode", "decode"] },
          "parameters": { "type": "object" }
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["held_out_unit", "baselines", "metrics", "multiple_testing_correction"],
      "properties": {
        "held_out_unit": { "type": "string", "minLength": 1 },
        "baselines": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "metrics": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "multiple_testing_correction": { "type": "string", "minLength": 1 }
      }
    },
    "notes": { "type": ["string", "null"] }
  }
}
