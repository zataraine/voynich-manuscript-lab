{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manuscript-lab.local/schemas/local-review.schema.json",
  "title": "Local experiment review",
  "type": "object",
  "required": [
    "experiment_id",
    "assessment",
    "anomalies",
    "confounds",
    "effect_strength",
    "followups",
    "confidence",
    "escalate"
  ],
  "properties": {
    "experiment_id": {"type": "string", "minLength": 1, "maxLength": 100},
    "assessment": {"type": "string", "minLength": 1, "maxLength": 512},
    "anomalies": {
      "type": "array",
      "maxItems": 8,
      "items": {"type": "string", "maxLength": 256}
    },
    "confounds": {
      "type": "array",
      "maxItems": 8,
      "items": {"type": "string", "maxLength": 256}
    },
    "effect_strength": {
      "type": "string",
      "enum": ["none", "weak", "moderate", "strong", "unknown"]
    },
    "followups": {
      "type": "array",
      "maxItems": 8,
      "items": {"type": "string", "maxLength": 256}
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "escalate": {"type": "boolean"}
  },
  "additionalProperties": false
}
