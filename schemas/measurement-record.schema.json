{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Control measurement record, not a calibrated target bundle",
  "type": "object",
  "required": ["schema_version", "record_type", "provenance", "seed", "battery_id", "battery_sha256", "metric_order", "scope", "input_projections_sha256", "symbol_table", "coverage", "record_provenance", "split", "measurements", "finite_sample", "nulls", "decision"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "control-measurement-v1"},
    "provenance": {
      "type": "object",
      "required": ["source_kind", "source_manifest", "source_manifest_sha256", "code_revision", "working_tree_sha256", "software_environment_sha256", "device", "output_path"],
      "properties": {
        "source_kind": {"enum": ["synthetic", "external-control"]},
        "source_manifest": {"type": "string", "minLength": 1},
        "source_manifest_sha256": {"$ref": "#/$defs/hash"},
        "code_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "working_tree_sha256": {"$ref": "#/$defs/hash"},
        "software_environment_sha256": {"$ref": "#/$defs/hash"},
        "device": {"type": "string", "minLength": 1},
        "output_path": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "seed": {"type": "integer"},
    "battery_id": {"const": "measurement-battery-v2"},
    "battery_sha256": {"$ref": "#/$defs/hash"},
    "metric_order": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "scope": {
      "type": "object",
      "required": ["registry_sha256", "view_id", "alphabet", "witness_id"],
      "properties": {
        "registry_sha256": {"$ref": "#/$defs/hash"},
        "view_id": {"type": "string", "minLength": 1},
        "alphabet": {"type": "string", "minLength": 1},
        "witness_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "input_projections_sha256": {"$ref": "#/$defs/hash"},
    "symbol_table": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "coverage": {"type": "object"},
    "record_provenance": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "split": {"type": "object", "required": ["minimum_group", "training_pages", "heldout_pages", "training_record_ids", "heldout_record_ids", "training_pages_without_usable_records", "heldout_pages_without_usable_records"], "properties": {"minimum_group": {"const": "physical_page"}}},
    "measurements": {
      "type": "object",
      "required": ["battery_id", "battery_sha256", "training", "heldout", "training_support", "heldout_support", "learned_units"],
      "properties": {
        "battery_id": {"const": "measurement-battery-v2"},
        "battery_sha256": {"$ref": "#/$defs/hash"},
        "training": {"$ref": "#/$defs/metrics"},
        "heldout": {"$ref": "#/$defs/metrics"},
        "training_support": {"type": "object"},
        "heldout_support": {"type": "object"},
        "learned_units": {
          "type": "object", "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["merge_table", "merge_table_encoding", "merge_table_sha256", "trained_merge_count", "heldout"],
            "properties": {
              "merge_table": {"type": "array"},
              "merge_table_encoding": {"const": "nested-pair-json-v1"},
              "merge_table_sha256": {"$ref": "#/$defs/hash"},
              "trained_merge_count": {"type": "integer", "minimum": 0},
              "heldout": {"$ref": "#/$defs/metrics"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "finite_sample": {
      "type": "object", "required": ["training", "heldout"],
      "properties": {"training": {"$ref": "#/$defs/profile"}, "heldout": {"$ref": "#/$defs/profile"}},
      "additionalProperties": false
    },
    "nulls": {
      "type": "object", "required": ["group_order_shuffle", "within_group_unit_shuffle", "iid_symbol_length_matched"],
      "propertyNames": {"enum": ["group_order_shuffle", "within_group_unit_shuffle", "iid_symbol_length_matched"]},
      "additionalProperties": {
        "type": "object", "required": ["metrics", "support"],
        "properties": {"metrics": {"$ref": "#/$defs/metrics"}, "support": {"type": "object"}},
        "additionalProperties": false
      }
    },
    "decision": {"const": "not_calibrated"},
    "null_ensemble": {
      "type": "object",
      "required": ["diagnostic_id", "battery_id", "battery_sha256", "base_seed", "replicate_seeds", "replicates", "metric_order", "observed", "observed_support", "families", "decision"],
      "properties": {
        "diagnostic_id": {"const": "null-ensemble-v1"},
        "battery_id": {"const": "measurement-battery-v2"},
        "battery_sha256": {"$ref": "#/$defs/hash"},
        "base_seed": {"type": "integer"},
        "replicate_seeds": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "integer"}},
        "replicates": {"type": "integer", "minimum": 2},
        "metric_order": {"type": "array", "items": {"type": "string"}},
        "observed": {"$ref": "#/$defs/metrics"},
        "observed_support": {"type": "object"},
        "families": {
          "type": "object", "required": ["group_order_shuffle", "within_group_unit_shuffle", "iid_symbol_length_matched"],
          "additionalProperties": {
            "type": "object", "additionalProperties": {
              "type": "object",
              "required": ["samples", "defined_replicates", "null_mean", "null_sample_sd", "observed_minus_null_mean"],
              "properties": {
                "samples": {"type": "array", "minItems": 2, "items": {"type": ["number", "null"]}},
                "defined_replicates": {"type": "integer", "minimum": 0},
                "null_mean": {"type": ["number", "null"]},
                "null_sample_sd": {"type": ["number", "null"], "minimum": 0},
                "observed_minus_null_mean": {"type": ["number", "null"]}
              },
              "additionalProperties": false
            }
          }
        },
        "decision": {"const": "not_calibrated"}
      },
      "additionalProperties": false
    },
    "layout": {
      "type": "object", "required": ["training", "heldout", "nulls"],
      "properties": {
        "training": {"$ref": "#/$defs/layout"},
        "heldout": {"$ref": "#/$defs/layout"},
        "nulls": {
          "type": "object", "required": ["group_order_shuffle", "within_group_unit_shuffle", "iid_symbol_length_matched"],
          "additionalProperties": {"$ref": "#/$defs/layout"}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "metrics": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "number"}},
    "layout": {
      "type": "object", "required": ["panel_id", "metric_order", "metric_rules", "metrics", "support"],
      "properties": {
        "panel_id": {"const": "layout-measurements-v1"},
        "metric_order": {"type": "array", "items": {"type": "string"}},
        "metric_rules": {"type": "object", "additionalProperties": {"const": "two_sided"}},
        "metrics": {"$ref": "#/$defs/metrics"},
        "support": {"type": "object"}
      },
      "additionalProperties": false
    },
    "profile": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["record_count", "unit_count", "metrics", "support"],
        "properties": {
          "record_count": {"type": "integer", "minimum": 1},
          "unit_count": {"type": "integer", "minimum": 1},
          "metrics": {"$ref": "#/$defs/metrics"},
          "support": {"type": "object"}
        },
        "additionalProperties": false
      }
    }
  }
}
